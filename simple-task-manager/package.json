{
  "name": "simple-task-manager",
  "version": "1.0.0",
  "description": "いつも目の前に置いておく、手書き風フォントのフローティングTo-Do。自然言語でタスクを入れるとClaudeが分解してくれます。",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "install-app": "bash install.sh"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1"
  },
  "build": {
    "appId": "com.yumeto.simple-task-manager",
    "productName": "やること",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dir",
      "identity": null,
      "category": "public.app-category.productivity"
    }
  }
}
